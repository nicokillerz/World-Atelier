{
  "name": "world-atelier",
  "productName": "World Atelier",
  "version": "1.3.2",
  "description": "Worldbuilding and character creation studio for writers, roleplayers, and original-character creators. / Ateliê de criação de mundos e personagens.",
  "main": "src/main/main.js",
  "author": "World Atelier contributors",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/nicokillerz/World-Atelier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicokillerz/World-Atelier.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --win --dir --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.worldatelier.app",
    "productName": "World Atelier",
    "copyright": "Copyright (c) 2026 World Atelier",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "WorldAtelier-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "WorldAtelier-${version}-portable.exe"
    }
  }
}
